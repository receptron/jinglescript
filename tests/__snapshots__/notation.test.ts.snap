<measure number="2"><note><pitch><step>G</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>So</text></lyric></note><note><pitch><step>A</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>La</text></lyric></note><note><pitch><step>B</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>Ti</text></lyric></note><note><pitch><step>C</step><octave>5</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>Do</text></lyric></note></measure>
<measure number="3"><note><pitch><step>B</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>Ti</text></lyric></note><note><pitch><step>A</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>La</text></lyric></note><note><pitch><step>G</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>So</text></lyric></note><note><pitch><step>F</step><octave>4</octave></pitch><duration>24</duration><voice>1</voice><type>quarter</type><staff>1</staff><lyric number="1"><syllabic>single</syllabic><text>Fa</text></lyric></note></measure>
