{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    // Type-check against the library's source, as the root repo does.
    "paths": { "jinglescript": ["../src/index.ts"], "jinglescript/browser": ["../src/browser.ts"] }
  },
  "include": ["src", "tests", "scripts", "demo", "playground", "vite.config.ts"]
}
